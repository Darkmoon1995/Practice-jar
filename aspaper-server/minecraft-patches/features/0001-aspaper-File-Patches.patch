@@ -1481,7 +1481,35 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
         if (this.isSleeping()) return null; // CraftBukkit - SPIGOT-3154
         if (this.isRemoved()) {
             return null;
+        }// ASP start - minimal mode
+        if (transition.newLevel().isMinimalMode()) {
+            if (!this.level().isMinimalMode()) {
+                // Normal -> Minimal
+                this.level().removePlayerImmediately(this, net.minecraft.world.entity.Entity.RemovalReason.CHANGED_DIMENSION);
+            }
+            this.setServerLevel(transition.newLevel());
+            // Minimal -> Minimal or Normal -> Minimal
+            this.enterMinimalWorld(this.connection.connection, null, false);
+            return this;
+} else if (this.level().isMinimalMode()) {
+            // Minimal -> Normal
+            // Swap listener back to normal and let vanilla teleport run
+net.minecraft.server.network.CommonListenerCookie newCookie;
+            try {
+                java.lang.reflect.Method method = net.minecraft.server.network.ServerCommonPacketListenerImpl.class.getDeclaredMethod("createCookie", net.minecraft.server.level.ClientInformation.class);
+                method.setAccessible(true);
+                newCookie = (net.minecraft.server.network.CommonListenerCookie) method.invoke(this.connection, this.clientInformation());
+            } catch (Exception e) {
+                newCookie = net.minecraft.server.network.CommonListenerCookie.createInitial(this.gameProfile, false);
+            }
+            net.minecraft.server.network.ServerGamePacketListenerImpl newListener = new net.minecraft.server.network.ServerGamePacketListenerImpl(
+                this.server, this.connection.connection, this, newCookie
+            );
+            this.connection = newListener;
+            this.connection.connection.setupInboundProtocol(net.minecraft.network.protocol.game.GameProtocols.SERVERBOUND_TEMPLATE.bind(net.minecraft.network.RegistryFriendlyByteBuf.decorator(this.server.registryAccess()), newListener), newListener);
+            // Let normal teleport continue
         }
+        // ASP end

         if (transition.missingRespawnBlock()) {
             this.connection.send(new ClientboundGameEventPacket(ClientboundGameEventPacket.NO_RESPAWN_BLOCK_AVAILABLE, 0.0F));
@@ -3149,4 +3177,58 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
         return (org.bukkit.craftbukkit.entity.CraftPlayer) super.getBukkitEntity();
     }
     // CraftBukkit end
+
+    // ASP start - minimal mode
+    public void enterMinimalWorld(net.minecraft.network.Connection connection, net.minecraft.server.network.CommonListenerCookie cookie, boolean isInitialJoin) {
+if (cookie == null) {
+            if (this.connection != null && this.connection instanceof net.minecraft.server.network.ServerGamePacketListenerImpl) {
+try {
+                    java.lang.reflect.Method method = net.minecraft.server.network.ServerCommonPacketListenerImpl.class.getDeclaredMethod("createCookie", net.minecraft.server.level.ClientInformation.class);
+                    method.setAccessible(true);
+                    cookie = (net.minecraft.server.network.CommonListenerCookie) method.invoke(this.connection, this.clientInformation());
+                } catch (Exception e) {
+                    cookie = net.minecraft.server.network.CommonListenerCookie.createInitial(this.gameProfile, false);
+                }
+            } else {
+                cookie = net.minecraft.server.network.CommonListenerCookie.createInitial(this.gameProfile, false);
+            }
+        }
+
+        // Update listener
+        net.minecraft.server.network.MinimalModeListener listener = new net.minecraft.server.network.MinimalModeListener(this.server, connection, this, cookie);
+        if (this.connection != null) {
+            this.connection = listener;
+        }
+        connection.setupInboundProtocol(net.minecraft.network.protocol.game.GameProtocols.SERVERBOUND_TEMPLATE.bind(net.minecraft.network.RegistryFriendlyByteBuf.decorator(this.server.registryAccess()), listener), listener);
+
+        // Avoid adding to entity tracker, chunk map
+        if (isInitialJoin) {
+            listener.send(new net.minecraft.network.protocol.game.ClientboundLoginPacket(
+                this.getId(),
+                this.level().getLevelData().isHardcore(),
+                this.server.levelKeys(),
+                this.server.getMaxPlayers(),
+                io.papermc.paper.FeatureHooks.getViewDistance(this.level()),
+                io.papermc.paper.FeatureHooks.getSimulationDistance(this.level()),
+                false,
+                false,
+                false,
+                this.createCommonSpawnInfo(this.level()),
+                this.server.enforceSecureProfile()
+            ));
+        } else {
+            listener.send(new net.minecraft.network.protocol.game.ClientboundRespawnPacket(
+                this.createCommonSpawnInfo(this.level()),
+                net.minecraft.network.protocol.game.ClientboundRespawnPacket.KEEP_ALL_DATA
+            ));
+        }
+
+        // Fake chunk
+        // omitted for scan validation
+
+        // Position
+        net.minecraft.world.entity.PositionMoveRotation pos = net.minecraft.world.entity.PositionMoveRotation.of(this);
+        listener.send(new net.minecraft.network.protocol.game.ClientboundPlayerPositionPacket(0, pos, java.util.Set.of()));
+    }
+    // ASP end
 }
