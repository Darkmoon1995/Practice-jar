diff --git a/net/minecraft/network/Connection.java b/net/minecraft/network/Connection.java
index 76596e87945f0b95af8032338a64817a8faed4d0..da9afb86af854699e037de9c6f1b8df876c2cc15 100644
--- a/net/minecraft/network/Connection.java
+++ b/net/minecraft/network/Connection.java
@@ -962,6 +962,11 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
         private static boolean canSendImmediate(final Connection connection, final net.minecraft.network.protocol.Packet<?> packet) {
             return connection.isPending || connection.packetListener.protocol() != ConnectionProtocol.PLAY ||
                 packet instanceof net.minecraft.network.protocol.common.ClientboundKeepAlivePacket ||
+        // PvP Fast-Path Additions:
+                packet instanceof net.minecraft.network.protocol.game.ClientboundSetEntityMotionPacket || // Entity Velocity (Knockback)
+                packet instanceof net.minecraft.network.protocol.game.ClientboundAnimatePacket ||         // Animation updates (Swings/Hurt)
+                packet instanceof net.minecraft.network.protocol.game.ClientboundMoveEntityPacket ||    // Tracking relative movement
+                packet instanceof net.minecraft.network.protocol.game.ClientboundTeleportEntityPacket ||  // Tracking absolute movement
                 packet instanceof net.minecraft.network.protocol.game.ClientboundPlayerChatPacket ||
                 packet instanceof net.minecraft.network.protocol.game.ClientboundSystemChatPacket ||
                 packet instanceof net.minecraft.network.protocol.game.ClientboundDisguisedChatPacket ||
