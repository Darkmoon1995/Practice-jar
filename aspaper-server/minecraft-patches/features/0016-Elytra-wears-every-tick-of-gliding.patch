+    // PracticePvP start - elytra wear: 0.0125 durability per tick of gliding (a quarter of vanilla's 1 per second),
+    // divided by Unbreaking + 1. Counted in whole ticks on the player, so stopping the glide or swapping elytras
+    // doesn't reset it
+    private int elytraWearTicks;
+
+    private void wearElytra() {
+        List<EquipmentSlot> slotsWithGliders = EquipmentSlot.VALUES.stream().filter(slot -> canGlideUsing(this.getItemBySlot(slot), slot)).toList();
+        if (slotsWithGliders.isEmpty()) {
+            return;
+        }
+        EquipmentSlot slot = Util.getRandom(slotsWithGliders, this.random);
+        ItemStack elytra = this.getItemBySlot(slot);
+        int unbreaking = 0;
+        for (it.unimi.dsi.fastutil.objects.Object2IntMap.Entry<net.minecraft.core.Holder<net.minecraft.world.item.enchantment.Enchantment>> entry
+                : elytra.getOrDefault(DataComponents.ENCHANTMENTS, net.minecraft.world.item.enchantment.ItemEnchantments.EMPTY).entrySet()) {
+            if (entry.getKey().is(net.minecraft.world.item.enchantment.Enchantments.UNBREAKING)) {
+                unbreaking = entry.getIntValue();
+                break;
+            }
+        }
+        int ticksPerDurability = 80 * (unbreaking + 1);
+        if (++this.elytraWearTicks >= ticksPerDurability) {
+            this.elytraWearTicks -= ticksPerDurability;
+            elytra.hurtAndBreak(1, this, slot);
+        }
+    }
+    // PracticePvP end
+
