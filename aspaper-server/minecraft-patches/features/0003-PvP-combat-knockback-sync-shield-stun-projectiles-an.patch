+    // PracticePvP start - shield stun
+    private static boolean practicePvPWearsArmor(final ServerPlayer player, final String material) {
+        for (ItemStack armor : player.getInventory().getArmorContents()) {
+            if (!armor.isEmpty() && net.minecraft.core.registries.BuiltInRegistries.ITEM.getKey(armor.getItem()).getPath().contains(material)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    // Vanilla damage tick on a shield block: skipped for diamond or netherite armor, otherwise per-player setting
+    private boolean practicePvPSkipDamageTickOnShieldBlock() {
+        if (this instanceof ServerPlayer player) {
+            return practicePvPWearsArmor(player, "diamond") || practicePvPWearsArmor(player, "netherite") || player.getBukkitEntity().isSkipVanillaDamageTickWhenShieldBlocked();
+        }
+        return io.papermc.paper.configuration.GlobalConfiguration.get().unsupportedSettings.skipVanillaDamageTickWhenShieldBlocked;
+    }
+
+    // Paper's shield block patch: skipped for diamond armor, kept for netherite, otherwise per-player setting
+    private boolean practicePvPSkipDamageTickOnShieldBlockPaper() {
+        if (this instanceof ServerPlayer player) {
+            if (practicePvPWearsArmor(player, "diamond")) return true;
+            if (practicePvPWearsArmor(player, "netherite")) return false;
+            return player.getBukkitEntity().isSkipVanillaDamageTickWhenShieldBlockedPaper();
+        }
+        return io.papermc.paper.configuration.GlobalConfiguration.get().unsupportedSettings.skipVanillaDamageTickWhenShieldBlocked;
+    }
+    // PracticePvP end - shield stun
+
+    // PracticePvP start - KnockbackSync helpers
+    /**
+     * Snapshots the current latency of this player for the next ground check.
+     */
+    public void kbSyncCapturePing() {
+        if (!(this instanceof ServerPlayer sp)) return;
+        long raw = sp.connection.latency();
+        this.kbSyncPrevPingMs = (this.kbSyncPingMs >= 0) ? this.kbSyncPingMs : raw;
+        this.kbSyncPingMs = raw;
+    }
+
+    /**
+     * Ping with a constant offset, ignoring sudden spikes over the previous sample.
+     */
+    private long kbSyncGetEstimatedPing(final ServerPlayer victim) {
+        long current = (this.kbSyncPingMs >= 0) ? this.kbSyncPingMs : (long) victim.connection.latency();
+        long previous = (this.kbSyncPrevPingMs >= 0) ? this.kbSyncPrevPingMs : current;
+        long ping = ((current - previous) > KB_SYNC_SPIKE_THRESHOLD) ? previous : current;
+        return Math.max(1L, ping - KB_SYNC_PING_OFFSET);
+    }
+
+    /**
+     * Distance from the feet to the closest solid surface below any bounding box corner, up to 5 blocks.
+     */
+    private double kbSyncGetDistanceToGround(final ServerPlayer victim) {
+        double collisionDist = 5.0;
+        AABB bb = victim.getBoundingBox();
+        double playerY = victim.getY();
+        double adj = 0.01; // inset to avoid clipping walls
+        double[] xs = { bb.minX + adj, bb.maxX - adj };
+        double[] zs = { bb.minZ + adj, bb.maxZ - adj };
+
+        for (double cx : xs) {
+            for (double cz : zs) {
+                Vec3 start = new Vec3(cx, playerY, cz);
+                Vec3 end = new Vec3(cx, playerY - 5.0, cz);
+                HitResult hit = this.level().clip(new ClipContext(start, end, ClipContext.Block.COLLIDER, ClipContext.Fluid.NONE, victim));
+                if (hit.getType() == HitResult.Type.BLOCK) {
+                    double dist = playerY - hit.getLocation().y;
+                    if (dist < collisionDist) collisionDist = dist;
+                }
+            }
+        }
+        return collisionDist;
+    }
+
+    /**
+     * Ticks until an upward velocity reaches its peak.
+     */
+    private int kbSyncCalcTimeToPeak(double velocity, final double gravity) {
+        int ticks = 0;
+        while (velocity > 0.0 && ticks <= KB_SYNC_MAX_FALL_TICKS) {
+            velocity = (velocity - gravity) * KB_SYNC_VELOCITY_MULT;
+            ticks++;
+        }
+        return ticks;
+    }
+
+    /**
+     * Height gained while rising for {@code ticks} ticks from {@code velocity}.
+     */
+    private double kbSyncCalcDistanceTraveled(double velocity, final int ticks, final double gravity) {
+        double total = 0.0;
+        for (int i = 0; i < ticks && velocity > 0.0; i++) {
+            total += velocity;
+            velocity = (velocity - gravity) * KB_SYNC_VELOCITY_MULT;
+        }
+        return total;
+    }
+
+    /**
+     * Ticks to fall {@code distance} blocks from a downward speed of {@code initialVelocity},
+     * or -1 past {@link #KB_SYNC_MAX_FALL_TICKS}.
+     */
+    private int kbSyncCalcFallTime(final double initialVelocity, double distance, final double gravity) {
+        double velocity = Math.abs(initialVelocity);
+        int ticks = 0;
+        while (distance > 0.0) {
+            if (ticks > KB_SYNC_MAX_FALL_TICKS) return -1;
+            velocity = Math.min((velocity + gravity) * KB_SYNC_VELOCITY_MULT, KB_SYNC_TERMINAL_VELOCITY);
+            distance -= velocity;
+            ticks++;
+        }
+        return ticks;
+    }
+
+    /**
+     * True if {@code victim} has already landed on their client but the server has not seen it yet,
+     * so the knockback should use the on-ground Y formula.
+     *
+     * @param victim the player receiving knockback
+     * @param serverYVelocity the server-side Y velocity, used when the client velocity is unknown
+     */
+    private boolean kbSyncIsOnGroundClientSide(final ServerPlayer victim, final double serverYVelocity) {
+        if (victim.onGround()) return false;
+        if (victim.isFallFlying()) return false;
+        if (victim.isInWater() || victim.isInLava()) return false;
+
+        long estimatedPing = this.kbSyncGetEstimatedPing(victim);
+        double gDist = this.kbSyncGetDistanceToGround(victim);
+        if (gDist <= 0.0 || gDist > KB_SYNC_MAX_GROUND_DIST) return false;
+
+        // The server never simulates player velocity, use what the client last reported
+        Vec3 known = victim.getKnownMovement();
+        double yVelocity = known.isFinite() ? known.y : serverYVelocity;
+        double gravity = victim.getGravity();
+
+        int tRise = 0;
+        double rise = 0.0;
+        if (yVelocity > 0.0) {
+            tRise = this.kbSyncCalcTimeToPeak(yVelocity, gravity);
+            rise = this.kbSyncCalcDistanceTraveled(yVelocity, tRise, gravity);
+            yVelocity = 0.0; // falls from the peak
+        }
+        int tFall = this.kbSyncCalcFallTime(yVelocity, rise + gDist, gravity);
+        if (tFall == -1) return false;
+
+        // Both are ticks, 50ms each
+        return estimatedPing >= (tRise + tFall) * 50L;
+    }
+    // PracticePvP end - KnockbackSync helpers
 }
