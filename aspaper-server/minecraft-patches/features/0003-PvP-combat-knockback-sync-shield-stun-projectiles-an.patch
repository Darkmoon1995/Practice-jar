+    @Nullable
+    private EntityHitResult checkSweptEntityCollision(Vec3 stepMotion, int totalSteps) {
+        AABB ourBox    = this.getBoundingBox();
+        Vec3 ourCenter = ourBox.getCenter();
+
+        // Broad-phase: cover our step path + buffer for the candidate's step.
+        // inflate(1.5) is generous even for fast projectiles at 0.5-block step sizes.
+        AABB broadPhase = ourBox.expandTowards(stepMotion).inflate(1.5);
+
+        EntityHitResult best       = null;
+        double          bestDistSq = Double.MAX_VALUE;
+
+        for (Entity candidate : this.level().getEntities(this, broadPhase, this::canHitEntity)) {
+            Vec3 candidateVel = candidate.getDeltaMovement();
+
+            // If the candidate is slow/stationary the primary raycast already handles it.
+            // Only bother with CCD for entities moving fast enough to tunnel.
+            if (candidateVel.lengthSqr() < 0.0625) continue; // < 0.25 b/t
+
+            // Scale candidate velocity to match our sub-step fraction so the
+            // relative-motion segment length is consistent with our step size.
+            Vec3 candidateStep = candidateVel.scale(1.0 / totalSteps);
+            Vec3 relMotion     = stepMotion.subtract(candidateStep);
+
+            // If relative motion is negligible, they're travelling in lockstep —
+            // no tunneling risk.
+            if (relMotion.lengthSqr() < 1.0e-7) continue;
+
+            // Minkowski sum: expand the candidate's box by OUR half-extents.
+            // We can then treat our projectile as a single point for the ray test.
+            // *** This does NOT change the candidate's hitbox in any way. ***
+            AABB minkBox = candidate.getBoundingBox().inflate(
+                    ourBox.getXsize() * 0.5,
+                    ourBox.getYsize() * 0.5,
+                    ourBox.getZsize() * 0.5
+            );
+
+            // Clip the relative-velocity ray against the expanded box.
+            // Returns the entry point if the segment [ourCenter, ourCenter+relMotion]
+            // intersects minkBox, i.e. the two swept volumes would overlap this sub-step.
+            Optional<Vec3> intersection = minkBox.clip(ourCenter, ourCenter.add(relMotion));
+            if (intersection.isEmpty()) continue;
+
+            double distSq = ourCenter.distanceToSqr(intersection.get());
+            if (distSq < bestDistSq) {
+                bestDistSq = distSq;
+                best = new EntityHitResult(candidate, intersection.get());
+            }
         }
+
+        return best;
     }
 
