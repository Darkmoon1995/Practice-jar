@@ -5178,23 +5196,18 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
     // PracticePvP end - shield stun
 
     // PracticePvP start - KnockbackSync helpers
-    /**
-     * Snapshots the current latency of this player for the next ground check.
-     */
-    public void kbSyncCapturePing() {
-        if (!(this instanceof ServerPlayer sp)) return;
-        long raw = sp.connection.latency();
-        this.kbSyncPrevPingMs = (this.kbSyncPingMs >= 0) ? this.kbSyncPingMs : raw;
-        this.kbSyncPingMs = raw;
+    /** Knockback sync is on for this player unless their match turned it off. */
+    private boolean kbSyncOn(final ServerPlayer victim) {
+        return !victim.getBukkitEntity().getPersistentDataContainer().has(KB_SYNC_OFF_KEY);
     }
 
     /**
-     * Ping with a constant offset, ignoring sudden spikes over the previous sample.
+     * The newest ping sample, or the 5 s average when the newest one is a spike over it; minus a constant offset.
      */
     private long kbSyncGetEstimatedPing(final ServerPlayer victim) {
-        long current = (this.kbSyncPingMs >= 0) ? this.kbSyncPingMs : (long) victim.connection.latency();
-        long previous = (this.kbSyncPrevPingMs >= 0) ? this.kbSyncPrevPingMs : current;
-        long ping = ((current - previous) > KB_SYNC_SPIKE_THRESHOLD) ? previous : current;
+        long average = victim.connection.latency();
+        long newest = victim.connection.practicePvPLastPingMs;
+        long ping = newest < 0 || newest - average > KB_SYNC_SPIKE_THRESHOLD ? average : newest;
         return Math.max(1L, ping - KB_SYNC_PING_OFFSET);
     }
 
@@ -5270,12 +5283,11 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
      * @param victim the player receiving knockback
      * @param serverYVelocity the server-side Y velocity, used when the client velocity is unknown
      */
-    private boolean kbSyncIsOnGroundClientSide(final ServerPlayer victim, final double serverYVelocity) {
+    private boolean kbSyncIsOnGroundClientSide(final ServerPlayer victim, final double serverYVelocity, final long estimatedPing) {
         if (victim.onGround()) return false;
         if (victim.isFallFlying()) return false;
         if (victim.isInWater() || victim.isInLava()) return false;
 
-        long estimatedPing = this.kbSyncGetEstimatedPing(victim);
         double gDist = this.kbSyncGetDistanceToGround(victim);
         if (gDist <= 0.0 || gDist > KB_SYNC_MAX_GROUND_DIST) return false;
 
@@ -5297,5 +5309,31 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
         // Both are ticks, 50ms each
         return estimatedPing >= (tRise + tFall) * 50L;
     }
+
+    /**
+     * The reverse case: the server still has {@code victim} on the ground, but they were hopping (sprint-jumping,
+     * jump-resetting) and on their screen have already jumped again by the time the knockback arrives. Returns their
+     * predicted upward speed at that moment, or NaN when they're on the ground there too.
+     *
+     * <p>Hopping means the landing the server saw ended a normal jump. Players jump again the tick they land, so on
+     * their screen they're airborne from one tick after landing; the knockback reaches them a full ping after the
+     * moment the server is looking at.
+     */
+    private double kbSyncOffGroundVelocity(final ServerPlayer victim, final long estimatedPing) {
+        if (victim.isFallFlying() || victim.isInWater() || victim.isInLava()) return Double.NaN;
+        int jump = victim.kbSyncJumpTick, landed = victim.kbSyncLandedTick;
+        if (jump < 0 || landed < jump) return Double.NaN;
+        if (landed - jump > KB_SYNC_MAX_HOP_TICKS) return Double.NaN; // landed from a fall, not a hop
+        int sinceLanding = victim.tickCount - landed;
+        if (sinceLanding < 0 || sinceLanding > KB_SYNC_MAX_FALL_TICKS) return Double.NaN;
+
+        long airborneMs = estimatedPing - (sinceLanding + 1) * 50L;
+        if (airborneMs <= 0) return Double.NaN;
+        // Their new jump's speed after the ticks it has been going
+        double velocity = victim.getJumpPower();
+        double gravity = victim.getGravity();
+        for (long t = airborneMs / 50L; t > 0; t--) velocity = (velocity - gravity) * KB_SYNC_VELOCITY_MULT;
+        return velocity;
+    }
     // PracticePvP end - KnockbackSync helpers
 }
