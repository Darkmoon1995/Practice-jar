@@ -0,0 +1,53 @@
+package net.minecraft.world.phys.shapes;
+
+import java.util.List;
+import java.util.concurrent.ConcurrentHashMap;
+import net.minecraft.world.phys.AABB;
+
+public class VoxelShapeCache {
+
+    // Thread-safe map to hold our unique shapes
+    private static final ConcurrentHashMap<String, VoxelShape> CACHE = new ConcurrentHashMap<>();
+
+    /**
+     * Deduplicates a VoxelShape by comparing its exact physical bounding boxes.
+     */
+    public static VoxelShape deduplicate(VoxelShape shape) {
+        // Fallback to Vanilla singletons for the most common shapes
+        if (shape == null || shape.isEmpty()) {
+            return Shapes.empty();
+        }
+        if (shape == Shapes.block()) {
+            return Shapes.block();
+        }
+
+        // Generate a precise key based on the actual hitboxes
+        String key = generateKey(shape);
+
+        // Return the existing shape if we already have it, otherwise store this new one
+        return CACHE.computeIfAbsent(key, k -> shape);
+    }
+
+    /**
+     * Generates a unique string key based on every internal bounding box of the shape.
+     * This guarantees 100% collision accuracy for PvP.
+     */
+    private static String generateKey(VoxelShape shape) {
+        List<AABB> boxes = shape.toAabbs();
+        if (boxes.isEmpty()) {
+            return "empty";
+        }
+
+        // Use a StringBuilder for fast string concatenation
+        StringBuilder sb = new StringBuilder();
+        for (AABB box : boxes) {
+            sb.append(box.minX).append(',')
+                    .append(box.minY).append(',')
+                    .append(box.minZ).append(',')
+                    .append(box.maxX).append(',')
+                    .append(box.maxY).append(',')
+                    .append(box.maxZ).append(';');
+        }
+        return sb.toString();
+    }
+}
