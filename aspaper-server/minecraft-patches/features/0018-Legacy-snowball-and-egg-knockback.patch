@@ -2133,6 +2139,40 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
         }
     }
 
+    // PracticePvP start - 1.8 snowball / egg knockback
+    /**
+     * 1.8's knockback for a snowball or egg hit: away from the thrower (the projectile when nobody threw it),
+     * half the old speed plus 0.4 sideways and 0.4 up - also in the air, unlike modern knockback, which only
+     * lifts players on the ground - with the upward speed capped at 0.4.
+     */
+    public void legacyThrownKnockback(final DamageSource source) {
+        Entity from = source.getEntity() != null ? source.getEntity() : source.getDirectEntity();
+        if (from == null) return;
+        double power = 0.4 * (1.0 - this.getAttributeValue(Attributes.KNOCKBACK_RESISTANCE));
+        double xd = from.getX() - this.getX();
+        double zd = from.getZ() - this.getZ();
+        while (xd * xd + zd * zd < 1.0E-4) {
+            xd = (Math.random() - Math.random()) * 0.01;
+            zd = (Math.random() - Math.random()) * 0.01;
+        }
+        double length = Math.sqrt(xd * xd + zd * zd);
+        Vec3 deltaMovement = this.getDeltaMovement();
+        Vec3 targetMovement = new Vec3(
+            deltaMovement.x / 2.0 - xd / length * power,
+            Math.min(0.4, deltaMovement.y / 2.0 + power),
+            deltaMovement.z / 2.0 - zd / length * power
+        );
+        Vec3 knockback = targetMovement.subtract(deltaMovement);
+        io.papermc.paper.event.entity.EntityKnockbackEvent event = CraftEventFactory.callEntityKnockbackEvent(this.getBukkitEntity(),
+            source.getDirectEntity(), source.getEntity(), io.papermc.paper.event.entity.EntityKnockbackEvent.Cause.ENTITY_ATTACK, power, knockback);
+        if (event.isCancelled()) {
+            return;
+        }
+        this.needsSync = true;
+        this.setDeltaMovement(deltaMovement.add(event.getKnockback().getX(), event.getKnockback().getY(), event.getKnockback().getZ()));
+    }
+    // PracticePvP end - 1.8 snowball / egg knockback
+
     public void knockback(final double power, final double xd, final double zd, final DamageSource source, final float damage) {
         // Paper start - knockback events
         this.knockback(power, xd, zd, source, damage, null, io.papermc.paper.event.entity.EntityKnockbackEvent.Cause.UNKNOWN);
